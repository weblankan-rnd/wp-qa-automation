{
  "name": "wordpress-qa-agent",
  "version": "1.0.0",
  "description": "Playwright-based QA automation suite for WordPress sites",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:header": "playwright test tests/header.spec.ts",
    "test:footer": "playwright test tests/footer.spec.ts",
    "test:forms": "playwright test tests/forms.spec.ts",
    "test:login": "playwright test tests/login.spec.ts",
    "test:registration": "playwright test tests/registration.spec.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:seo": "playwright test tests/seo.spec.ts",
    "test:links": "playwright test tests/broken-links.spec.ts",
    "test:nav": "playwright test tests/navigation.spec.ts",
    "test:perf": "playwright test tests/performance.spec.ts",
    "test:console": "playwright test tests/console-errors.spec.ts",
    "test:buttons": "playwright test tests/buttons.spec.ts",
    "test:broken-links": "playwright test tests/broken-links.spec.ts",
    "test:images": "playwright test tests/images.spec.ts",
    "test:chrome": "playwright test --project 'Desktop Chrome' --project 'Mobile Chrome'",
    "test:firefox": "playwright test --project 'Desktop Firefox'",
    "test:safari": "playwright test --project 'Desktop Safari' --project 'Mobile Safari'",
    "test:webkit": "playwright test --project 'Desktop Safari' --project 'Mobile Safari'",
    "test:desktop": "playwright test --project 'Desktop Chrome' --project 'Desktop Firefox' --project 'Desktop Safari'",
    "test:mobile": "playwright test --project 'Mobile Chrome' --project 'Mobile Safari'",
    "test:browser": "playwright test --project",
    "test:smoke": "playwright test --grep @smoke",
    "test:staging": "ENVIRONMENT=staging playwright test",
    "test:live": "ENVIRONMENT=live playwright test",
    "live:chrome": "ENVIRONMENT=live playwright test --project 'Desktop Chrome' --project 'Mobile Chrome'",
    "live:firefox": "ENVIRONMENT=live playwright test --project 'Desktop Firefox'",
    "live:safari": "ENVIRONMENT=live playwright test --project 'Desktop Safari' --project 'Mobile Safari'",
    "live:desktop": "ENVIRONMENT=live playwright test --project 'Desktop Chrome' --project 'Desktop Firefox' --project 'Desktop Safari'",
    "live:mobile": "ENVIRONMENT=live playwright test --project 'Mobile Chrome' --project 'Mobile Safari'",
    "live:browser": "ENVIRONMENT=live playwright test --project"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.3"
  }
}
