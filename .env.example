# ─── Target Site ───────────────────────────────────────────────────────────────
# Set to your staging or live WordPress URL (no trailing slash)
BASE_URL=https://supercorals.hostweblankan.in

# ─── Environment ───────────────────────────────────────────────────────────────
# Values: staging | live
# "live" automatically restricts destructive tests (forms, registration, login writes)
ENVIRONMENT=staging

# ─── WordPress Credentials (staging only) ──────────────────────────────────────
WP_USERNAME=your-username
WP_PASSWORD=your-password
WP_LOGIN_URL=/wp-login.php

# ─── Test Registration User (staging only) ─────────────────────────────────────
# This user will be created during registration tests — use a disposable address
TEST_REG_EMAIL=qa-test-user@example.com
TEST_REG_USERNAME=qa-testuser
TEST_REG_PASSWORD=QaTest!2024

# ─── Performance ───────────────────────────────────────────────────────────────
# Set to true to make load time tests FAIL when slow (default: false = warn only)
# Keep false on staging/test environments where the server can be slow
CHECK_LOAD_TIME=false
LOAD_TIME_THRESHOLD_MS=3000

# ─── Optional: Slack/Email alert webhook ───────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
