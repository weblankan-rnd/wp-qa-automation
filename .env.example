# ─── Target Site ────────────────────────────────────────────────────────────────
BASE_URL=https://yoursite.com
ENVIRONMENT=live

# ─── Pages to test (one per line inside quotes).
# Leave PAGES unset or empty to auto-discover via sitemap.
PAGES="
/
/about-us/
/contact-us/
"

# ─── Browser Matrix ─────────────────────────────────────────────────────────────
FULL_MATRIX=false

# ─── Performance ────────────────────────────────────────────────────────────────
LOAD_TIME_THRESHOLD_MS=5000
LCP_LIMIT_MS=4000
MAX_RENDER_BLOCKING=8
CHECK_LOAD_TIME=false

# ─── Images ─────────────────────────────────────────────────────────────────────
IMAGE_SIZE_LIMIT_KB=500

# ─── Accessibility ──────────────────────────────────────────────────────────────
# Minimum impact level to fail on: critical, serious, moderate, minor
ACCESSIBILITY_IMPACT=critical

# ─── Visual Regression ──────────────────────────────────────────────────────────
# Set to true to update screenshot baselines
UPDATE_SNAPSHOTS=false
# Pixel-diff threshold (0.05 = 5% maximum mismatched pixels allowed)
VISUAL_REGRESSION_THRESHOLD=0.05

# ─── Page Discovery ─────────────────────────────────────────────────────────────
# Set to true in CI to skip sitemap discovery and use pre-cached pages
SKIP_PAGE_DISCOVERY=false
# Max pages to discover and test
MAX_PAGES_TO_CHECK=20

# ─── Focus / Keyboard ───────────────────────────────────────────────────────────
MAX_FOCUS_CHECK=30

# ─── CI / Slack ─────────────────────────────────────────────────────────────────
# (Optional) Slack incoming webhook for failure notifications
SLACK_WEBHOOK_URL=
